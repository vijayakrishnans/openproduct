{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openproduct-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The site's own database (builder-profiles D8). This names stage's;
  // scripts/select-env.mjs swaps in prod's when the build runs for prod.
  "d1_databases": [
    { "binding": "DB", "database_name": "openproduct-web-stage", "database_id": "c15aee01-e621-4cc1-98ae-d0b0cf399555" }
  ],
  // Cover images for builds listed here (list-your-build LB5). This names
  // stage's bucket; scripts/select-env.mjs swaps in prod's for prod.
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "openproduct-web-covers-stage" }],
  // Demo sign-in (OP-34): on for stage and local; scripts/select-env.mjs
  // turns it off for prod, so prod never signs anyone in without a provider.
  "vars": { "DEMO_SIGNIN": "on" },
  "observability": { "enabled": true }
}
